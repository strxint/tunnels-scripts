#### Just a function that fixes part labels

fixlabels() {

  #### UEFI grub

  cat <<EOT >/mnt/etc/default/grub
GRUB_TIMEOUT=30
GRUB_DISABLE_SUBMENU=y
GRUB_DISABLE_RECOVERY=true
GRUB_CMDLINE_LINUX_DEFAULT="modules=sd-mod,usb-storage,ext4 quiet splash fastboot nomodeset fsck.mode=skip rootfstype=ext4 rw"
GRUB_CMDLINE_LINUX="root=LABEL=$LABEL_ROOT"
GRUB_DISABLE_LINUX_UUID=true
EOT

  #### BIOS syslinux

  cat <<EOT >/mnt/boot/syslinux/syslinux.cfg
DEFAULT tunnels-legacy
TIMEOUT 300
UI vesamenu.c32

MENU COLOR background 0 #00000000 #333333 std
MENU COLOR screen 0 #00000000 #333333 std

LABEL tunnels-gpu
    MENU LABEL Tunnels Graphics (GPU)
    LINUX /boot/vmlinuz-linux-lts
    INITRD /boot/initramfs-linux-lts.img
    APPEND root=LABEL=$LABEL_ROOT rw loglevel=3 fastboot

LABEL tunnels-legacy
    MENU LABEL Tunnels Legacy (no GPU)
    LINUX /boot/vmlinuz-linux-lts
    INITRD /boot/initramfs-linux-lts.img
    APPEND root=LABEL=$LABEL_ROOT rw nomodeset loglevel=3 fastboot
EOT

  #### fstab

  cat <<EOT >/mnt/etc/fstab
LABEL=$LABEL_ROOT      /       ext4    rw,relatime     0 0
/dev/cdrom      /media/cdrom    iso9660 noauto,ro 0 0
/dev/usbdisk    /media/usb      vfat    noauto  0 0
tmpfs   /tmp    tmpfs   nosuid,nodev    0       0
EOT

  
  if [ $SCRIPTS == "yes" ]; then
  	cp /usr/local/bin/* /mnt/usr/local/bin >/dev/null 2>&1  
  fi

}

verbose_sysinstall() {

  umount -l "$TARGET" >/dev/null 2>&1

  OK="\e[94m[\e[92mOK\e[94m]\e[0m"
  BAD="\e[94m[\e[91m!!\e[94m]\e[0m"

  echo -e "\n\e[94m[\e[93m*\e[94m] \e[97mWiping old fs on \e[95m$TARGET ...\e[0m"
  wipefs -fa $TARGET && code=$OK || code=$BAD

  echo -e "\n\e[94m[\e[97m!\e[94m] \e[97mWipe status: $code\e[0m"

  sleep 2

  echo -e "\n\e[94m[\e[93m*\e[94m] \e[97mCopying filesystem (this can take long) ...\e[0m"
  dd if=$MEDIA of=$TARGET bs=$BS status=progress && code=$OK || code=$BAD

  echo -e "\n\e[94m[\e[97m!\e[94m] \e[97mFilesystem copy status: $code\e[0m"

  sleep 2

  echo -e "\n\e[94m[\e[93m*\e[94m] \e[97mSync disks [1/3] ...\e[0m"
  
  sync && code=$OK || code=$BAD

  echo -e "\n\e[94m[\e[97m!\e[94m] \e[97mSync disk status [1/3]: $code\e[0m"

  sleep 2

  echo -e "\n\e[94m[\e[93m*\e[94m] \e[97mWriting partition LABEL\e[0m"
  e2label "$TARGET" "$LABEL_ROOT"
  partprobe "$TARGET" && code=$OK || code=$BAD

  echo -e "\n\e[94m[\e[93m!\e[94m] \e[97mLabel write status: $code\e[0m"

  sleep 1

  echo -e "\n\e[94m[\e[93m*\e[94m] \e[97mWriting fstab ...\e[0m"

  mount "$TARGET" /mnt
  
  fixlabels && code=$OK || code=$BAD

  echo -e "\n\e[94m[\e[93m!\e[94m] \e[97mWrite fstab status: $code\e[0m"

  sleep 1

  echo -e "\n\e[94m[\e[93m*\e[94m] \e[97mSync disks [3/3] ...\e[0m"
  sync && code=$OK || code=$BAD
  echo -e "\n\e[94m[\e[93m!\e[94m] \e[97mSync disks status: $code\e[0m"

  sleep 1

  echo -e "\n\e[94m[\e[93m*\e[94m] \e[97mUmount & disk cleaning ...\e[0m"

  umount -l "$TARGET" && code=$OK || code=$BAD

  echo -e "\n\e[94m[\e[93m!\e[94m] \e[97mUmount & clean status: $code\e[0m"

  sleep 2

  if ! [ $? == 0 ]; then
    echo -e "\n\e[91m[\e[97m-\e[91m] \e[91mErrors ocurred, fix or try again: $? !!\e[0m\n"
    exit 1
  else
    echo -e "\n\e[94m[\e[92m+\e[94m] \e[97mInstallation completed, reboot and unplug the USB/Media\e[0m\n"
    exit 0
  fi
  echo -e "\n"

}

verbose_img_maker() {

  OK="\e[94m[\e[92mOK\e[94m]\e[0m"
  BAD="\e[94m[\e[92m!!\e[94m]\e[0m"

  echo -e "\n\e[94m[\e[93m!\e[94m] \e[97mChecking Path ...\e[0m"
  sleep 2

  if [[ -r "$MEDIA" ]]; then
    echo -e "\n\e[94m[\e[93m*\e[94m] \e[97mPath check status: $OK\e[0m"
    sleep 2

    echo -e "\n\e[94m[\e[93m!\e[94m] \e[97mCreating initial file ...\e[0m"
    sleep 2

    if ! touch "$OUTPUT_FILE"; then
      echo -e "\n\e[91m[\e[97m-\e[91m] \e[97mFailed to create the initial .img file\e[0m"
      sleep 2
      exit 1
    else
      echo -e "\n\e[94m[\e[93m*\e[94m] \e[97mInitial file creation status: $OK\e[0m"
      sleep 2
    fi

    echo -e "\n\e[94m[\e[93m!\e[94m] \e[97mGenerating '\e[93m$OUTPUT_FILE\e[97m' ...\e[0m"
    sleep 2

    dd if="$MEDIA" of="$OUTPUT_FILE" bs=$BS status=progress && code="$OK" || code="$BAD"

    echo -e "\n\e[94m[\e[93m*\e[94m] \e[97mGenerate status: $OK\e[0m\n"

  else
    echo -e "\n\e[91m[\e[97m-\e[91m] \e[91mNo such device '$MEDIA'\e[0m\n"
    exit 1
  fi

  exit $?

}

