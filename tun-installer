#### OR AN .img WRITER ####

img_write() {

  if [ "$VERBOSE" == "yes" ]; then
    verbose_img_maker
  fi

  OK="\e[94m[\e[92mOK\e[94m]\e[0m"
  BAD="\e[94m[\e[92m!!\e[94m]\e[0m"

  echo -e "\n\e[94m[\e[93m!\e[94m] \e[97mChecking Path ...\e[0m"
  sleep 2

  if [[ -r "$MEDIA" ]]; then
    echo -e "\n\e[94m[\e[93m*\e[94m] \e[97mPath check status: $OK\e[0m"
    sleep 2

    echo -e "\n\e[94m[\e[93m!\e[94m] \e[97mCreating initial file ...\e[0m"
    sleep 2

    if ! touch "$OUTPUT_FILE" >/dev/null 2>&1; then
      echo -e "\n\e[91m[\e[97m-\e[91m] \e[97mFailed to create the initial .img file\e[0m"
      sleep 2
      exit 1
    else
      echo -e "\n\e[94m[\e[93m*\e[94m] \e[97mInitial file creation status: $OK\e[0m"
      sleep 2
    fi

    echo -e "\n\e[94m[\e[93m!\e[94m] \e[97mGenerating '\e[93m$OUTPUT_FILE\e[97m' ...\e[0m"
    sleep 2

    dd if="$MEDIA" of="$OUTPUT_FILE" bs=$BS conv=fsync status=progress && code="$OK" || code="$BAD"

    echo -e "\n\e[94m[\e[93m*\e[94m] \e[97mGenerate .img status: $OK\e[0m\n"

  else
    echo -e "\n\e[91m[\e[97m-\e[91m] \e[91mNo such device '$MEDIA'\e[0m\n"
    exit 1
  fi

  exit $?
}

###### PROMPT QUESTIONS ######

d_ask() {
  echo -ne "\n"
  lsblk -o NAME,MAJ:MIN,RM,SIZE,RO,TYPE,MOUNTPOINTS,LABEL,FSTYPE
  read -e -p $'\n\e[97mEnter an \e[95mUSB/Drive \e[97mor an \e[95m.img\e[97m file => \e[0m' MEDIA $MEDIA

  read -e -p $'\n\e[97mEnter the installation \e[96mdisk \e[97mor \e[96mname\e[97m for a new .img => \e[0m' TARGET $TARGET
}

ask_wipe() {
  read -e -p $"$(echo -e "\n\e[93m[\e[97m!\e[93m] \e[91mAll data in \e[93m$TARGET\e[91m will be lost, \e[97mcontinue? (y|N)\e[97m => \e[0m")" RESPONSE $RESPONSE
}

d_eval() {

  if [[ "$FRIENDLY" == "yes" ]]; then
    d_ask
  fi

  ##### DECIDE IF SYSINSTALL OR img_MAKER #####

  if [ -z "$MEDIA" ] && [ -z "$TARGET" ]; then
    echo -e "\n\e[91m[\e[97m-\e[91m] Give at least one Media and one output\e[0m\n"
    exit 1
  fi

  if [ -d "$MEDIA" ] || [ -d "$TARGET" ]; then
    echo -e "\n\e[92m[\e[97m-\e[92m] \e[91mYou are trying to write a directory!\e[0m\n"
    exit 1
  fi

  if [[ -r "$MEDIA" ]] && [[ -r "$TARGET" ]]; then # if both disks then sys install
    sync >/dev/null 2>&1
    umount -l "$TARGET" >/dev/null 2>&1

    if [[ $ASK == "yes" ]]; then
      ask_wipe
    else
      install_sys
    fi

  elif ! [[ -d "$MEDIA" ]] || ! [[ -r "$MEDIA" ]] && [[ -r "$TARGET" ]]; then # burn .img to target
    OUTPUT_FILE="$TARGET"
    img_write
  elif [[ -r "$MEDIA" ]] && ! [[ -r "$TARGET" ]] || ! [[ -d "$TARGET" ]]; then # burn target input to .img
    OUTPUT_FILE="$TARGET"
    img_write
  else
    echo -e "\n\e[92m[\e[97m-\e[92m] \e[91mBad selection, check device list\e[0m"
    exit 1
  fi

  ##### CONDITION ONLY AFFECTS SYS INSTALLATION ####

  if [[ "$RESPONSE" == "yes" ]] || [[ "$RESPONSE" == "y" ]] || [[ "$RESPONSE" == "Y" ]]; then
    install_sys
  elif [[ "$RESPONSE" == "no" ]] || [[ "$RESPONSE" == "n" ]] || [[ "$RESPONSE" == "N" ]]; then
    echo -e "\n\e[91mOperation cancelled\e[0m\n"
    exit 0
  elif [[ -z "$RESPONSE" ]]; then
    echo -ne "\n"
    exit 1
  else
    echo -e "\n\e[92m[\e[97m-\e[92m] \e[91mInvalid answer, try again\e[0m\n"
    exit 1
  fi

}

loadcfg() {
  if [ -z "$CONFIG_FILE" ] || ! [ -f "$CONFIG_FILE" ]; then
    echo -e "\n\e[91m[\e[97m-\e[91m]\e[93m note:\e[91m tun-installer --config-file <VALID_CONFIG>\n"
    exit 1
  else
    source "$CONFIG_FILE"
    d_eval
  fi
}

##### OPTIONS #####

if [[ $# -gt 0 ]]; then
  while [[ $# -gt 0 ]]; do
    case $1 in
     --media | -m)
      NEW_MEDIA=$2
      chmedia
      shift 2
      ;;
    --output | -o)
      NEW_TARGET=$2
      chtarget
      shift 2
      ;;
    --labels | -l)
      NEW_LABEL_ROOT=$2
      chlabels
      shift 3
      ;;
    --no-interactive | -n)
      FRIENDLY="no"
      shift 1
      ;;
    --interactive | -i)
      FRIENDLY="yes"
      shift 1
      ;;
    --copy-scripts | -C)
      SCRIPTS="yes"
      shift 1
      ;;
    --force-yes | -y)
      ASK="no"
      shift 1
      ;;
    --ask | -A)
      ASK="yes"
      shift 1
      ;;
    --verbose | -v)
      VERBOSE="yes"
      shift 1
      ;;
    --config-file | -f)
      CONFIG_FILE=$2
      loadcfg
      shift 2
      ;;
    --config-example | -e)
      config_ex
      shift 1
      ;;
    --version | -V)
      version
      shift 1
      ;;
    --help | -h)
      usage
      shift 1
      ;;
    --* | -* | *)
      usage
      shift 1
      ;;
    esac
  done
  d_eval
else
  d_eval
fi
