start() {

  # Goodbye SELinux ! #

  setenforce 0 >/dev/null 2>&1
  semanage permissive -a unconfined_t >/dev/null 2>&1

  # Ensuring Kernel modules before launching nft commands #

  modprobe nft_nat >/dev/null 2>&1
  modprobe nft_chain_nat >/dev/null 2>&1
  modprobe nf_nat >/dev/null 2>&1

  # Force firewall rules here #

  chattr -i $FWFILE >/dev/null 2>&1

  rm $FWFILE >/dev/null 2>&1
  touch $FWFILE >/dev/null 2>&1

  nft flush ruleset >/dev/null 2>&1

  cat <<EOT >$FWFILE
table ip6 filter {
        chain INPUT {
                type filter hook input priority filter; policy drop;
                meta l4proto ipv6-icmp icmpv6 type echo-request counter packets 0 bytes 0 drop
        }

        chain FORWARD {
                type filter hook forward priority filter; policy drop;
        }

        chain OUTPUT {
                type filter hook output priority filter; policy drop;
        }
}
table ip filter {
        chain INPUT {
                type filter hook input priority filter; policy drop;
                iifname "$IFNAME" counter packets 0 bytes 0 accept
                ct state related,established counter packets 0 bytes 0 accept
                iifname "$IFNAME" ip protocol icmp icmp type echo-request ct state related,established counter packets 0 bytes 0 accept
                ip protocol icmp icmp type echo-request counter packets 0 bytes 0 drop
        }

        chain OUTPUT {
                type filter hook output priority filter; policy drop;
                oifname "$IFNAME" counter packets 0 bytes 0 accept
                ct state new,related,established counter packets 0 bytes 0 accept
                oifname "$IFNAME" ip protocol icmp icmp type echo-request ct state new,related,established counter packets 0 bytes 0 accept
                ip protocol icmp icmp type echo-request counter packets 0 bytes 0 drop
                skuid $TOR_USER counter packets 0 bytes 0 accept
                ip daddr $ADDR udp dport $TDNS counter packets 0 bytes 0 accept
                ip daddr $ADDR tcp dport $TRANS counter packets 0 bytes 0 accept
                ip daddr $ADDR tcp dport $SOCKS counter packets 0 bytes 0 accept
                ip daddr $ADDR tcp dport $HTTP counter packets 0 bytes 0 accept
		        ip daddr $ADDR tcp dport $I2PHTTP counter packets 0 bytes 0 accept
		        ip daddr $ADDR tcp dport $I2PSOCKS counter packets 0 bytes 0 accept
                counter packets 0 bytes 0 reject
        }

        chain FORWARD {
                type filter hook forward priority filter; policy drop;
        }
}
table ip nat {
        chain OUTPUT {
                type nat hook output priority dstnat; policy accept;
                ip daddr $ADDR udp dport 53 counter packets 0 bytes 0 redirect to :$TDNS
                ip daddr $ADDR tcp dport 53 counter packets 0 bytes 0 redirect to :$TDNS
                skuid $TOR_USER counter packets 0 bytes 0 return
                ip daddr 127.0.0.0/8 counter packets 0 bytes 0 return
                ip daddr 192.168.0.0/16 counter packets 0 bytes 0 return
                ip daddr 10.0.0.0/8 counter packets 0 bytes 0 return
                ip daddr 172.16.0.0/12 counter packets 100 bytes 100 return
                ip daddr 169.254.0.0/16 counter packets 0 bytes 0 return
                ip daddr 255.255.255.255 counter packets 0 bytes 0 return
                ip daddr 224.0.0.0/4 counter packets 0 bytes 0 return
		        udp dport 53 counter packets 0 bytes 0 redirect to :$TDNS
                tcp dport 53 counter packets 0 bytes 0 redirect to :$TDNS
                tcp flags & (fin | syn | rst | ack) == syn counter packets 0 bytes 0 redirect to :$TRANS
                }
}
EOT

  chattr +i $FWFILE >/dev/null 2>&1

  nft -f $FWFILE >/dev/null 2>&1 && echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Put Firewall${NC}" || echo -e "\n${RED}[${WHITE}-${RED}] Error: Put Firewall${NC}"

  sleep 1

  # Say goodbye to old PIDs and welcome to securest transparent proxy experience (i love my localhost) #

  pkill -9 tor >/dev/null 2>&1
  pkill -9 NetworkManager >/dev/null 2>&1

  chattr -i $DNSFILE >/dev/null 2>&1

  rm $DNSFILE >/dev/null 2>&1
  touch $DNSFILE >/dev/null 2>&1

  echo -e "nameserver $ADDR" | tee $DNSFILE >/dev/null 2>&1 && echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Private DNS${NC}" || echo -e "\n${RED}[${WHITE}-${RED}] Error: Private DNS${NC}"

  sleep 1

  chmod 644 $DNSFILE >/dev/null 2>&1
  chattr +i $DNSFILE >/dev/null 2>&1

  while ! pgrep -x NetworkManager >/dev/null 2>&1; do
    NetworkManager >/dev/null 2>&1 && break || continue
  done && echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Fix Network${NC}" || echo -e "\n${RED}[${WHITE}-${RED}] Error: Fix Network${NC}"

  sleep 1

  tor --User $TOR_USER --RunAsDaemon 1 --DataDirectory /var/lib/tor -f $TORRC >/dev/null 2>&1 && echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Run Tor Daemon${NC}" || echo -e "\n${RED}[${WHITE}-${RED}] Error: Run Tor Daemon${NC}"

  sleep 1

  i2pd --daemon >/dev/null 2>&1 && echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Run i2p Daemon${NC}" || echo -e "\n${RED}[${WHITE}-${RED}] Error: Run i2p Daemon${NC}"

  sleep 1

  sysctl -w net.ipv6.conf.all.disable_ipv6=1 >/dev/null 2>&1
  sysctl -w net.ipv4.icmp_echo_ignore_all=1 >/dev/null 2>&1
  sysctl -w net.ipv6.icmp.echo_ignore_all=1 >/dev/null 2>&1
  sysctl --system >/dev/null 2>&1 && echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Apply sysctl rules${NC}" || echo -e "\n${RED}[${WHITE}-${RED}] Error: Apply sysctl rules${NC}"

  sleep 1

  # Proxy PID simple check to confirm everything works #

  if pgrep -x tor >/dev/null 2>&1 && pgrep -a i2pd >/dev/null 2>&1; then

    sleep 1

    echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Tor/i2p Runs${NC}"

  else
    sleep 1

    echo -e "\n${RED}[${WHITE}-${RED}] Error: Tor/i2p not Runs${NC}"
    exit 1
  fi
}

# Apply Default Torrc if user have not used other tool to apply a custom one #

config() {

  # here the check #

  if ! grep -IE "NOT TOUCH, THIS FILE IS CUSTOM LOAD" $TORRC >/dev/null 2>&1; then

    chattr -i $TORRC >/dev/null 2>&1

    rm $TORRC >/dev/null 2>&1
    touch $TORRC >/dev/null 2>&1

    # default template #

    cat <<EOT >$TORRC
# By Archnon Anonymous, Default Template for Torrc #
# File locked by chattr +i, unlock: chattr -i $TORRC

CookieAuthentication 0
VirtualAddrNetworkIPv4 10.192.0.0/10
AutomapHostsOnResolve 1
AutomapHostsSuffixes .exit,.onion
TransPort $ADDR:$TRANS IsolateClientAddr IsolateSOCKSAuth IsolateClientProtocol IsolateDestPort IsolateDestAddr
DNSPort $ADDR:$TDNS IsolateClientAddr IsolateSOCKSAuth IsolateClientProtocol IsolateDestPort IsolateDestAddr
SocksPort $ADDR:$SOCKS IsolateClientAddr IsolateSOCKSAuth IsolateClientProtocol IsolateDestPort IsolateDestAddr
ControlPort $ADDR:$CONTROL
HTTPTunnelPort $ADDR:$HTTP
EntryNodes {is},{ch},{fi},{ro}
ExitNodes {is},{ch},{fi},{ro}
StrictNodes 1
MaxCircuitDirtiness 10
ClientUseIPv6 0
ClientPreferIPv6ORPORT 0
ClientRejectInternalAddresses 1
AvoidDiskWrites 1
EnforceDistinctSubnets 1
HardwareAccel 1

EOT

    chattr +i $TORRC >/dev/null 2>&1

  fi

  # Tor user detection(for firewall rules) #

  if id debian-tor >/dev/null 2>&1; then
    export TOR_USER="debian-tor"
    echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} System Tor user: ${GREEN}$TOR_USER${NC}"

  elif id tor >/dev/null 2>&1; then
    export TOR_USER="tor"
    echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} System Tor user: ${GREEN}$TOR_USER${NC}"

  elif id toranon >/dev/null 2>&1; then
    export TOR_USER="toranon"
    echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} System Tor user: ${GREEN}$TOR_USER${NC}"

  else
    echo -e "\n${RED}[${WHITE}-${RED}] Error: no system user for tor${NC}"
    read -e -p $'\n\e[91m[\e[93m!\e[91m]\e[97m Enter a system user for launch tor: \e[92m' TOR_USER $TOR_USER

    if id $TOR_USER >/dev/null 2>&1; then
      export TOR_USER=$TOR_USER
      echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} System Tor user: ${GREEN}$TOR_USER${NC}"

    else
      echo -e "\n${RED}[${WHITE}-${RED}] Error: Invalid user ${ORANGE}'$TOR_USER'${NC}"
      exit 1

    fi

  fi

  chown -R $TOR_USER:$TOR_USER $TORRC >/dev/null 2>&1
  chown -R $TOR_USER:$TOR_USER /var/lib/tor >/dev/null 2>&1
  chmod 700 /var/lib/tor >/dev/null 2>&1

  sleep 1

  start
}

stop() {

  if ! pgrep -a i2pd >/dev/null 2>&1 && ! pgrep -x tor >/dev/null 2>&1; then
    echo -e "\n${RED}[${WHITE}-${RED}] Error: No active Tor/i2p${NC}"
    exit 1
  fi

  # Everything starts being normal from here #

  pkill -9 tor >/dev/null 2>&1
  pkill -9 i2pd >/dev/null 2>&1
  pkill -9 NetworkManager >/dev/null 2>&1 && echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Killed: Tor, i2pd, network${NC}" || echo -e "\n${RED}[${WHITE}-${RED}] Error: Not killed Tor/i2pd/network${NC}"

  sleep 1

  chattr -i $DNSFILE >/dev/null 2>&1
  rm $DNSFILE >/dev/null 2>&1
  touch $DNSFILE >/dev/null 2>&1

  echo nameserver $TRUSTED | tee $DNSFILE >/dev/null 2>&1 && echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Set DNS to: \e[92m'$TRUSTED'${NC}" || echo -e "\n${RED}[${WHITE}-${RED}] Error: set DNS to ${ORANGE}'$TRUSTED'${NC}"

  sleep 1

  chattr +i $DNSFILE >/dev/null 2>&1

  while ! pgrep -x NetworkManager >/dev/null 2>&1; do

    NetworkManager >/dev/null 2>&1 && continue || break

  done && echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Fix network${NC}" || echo -e "\n${RED}[${WHITE}-${RED}] Error: No network fixed${NC}"

  sleep 1

  sysctl -w net.ipv6.conf.all.disable_ipv6=0 >/dev/null 2>&1
  sysctl -w net.ipv4.icmp_echo_ignore_all=0 >/dev/null 2>&1
  sysctl -w net.ipv6.icmp.echo_ignore_all=0 >/dev/null 2>&1
  sysctl -w net.ipv6.conf.lo.disable_ipv6=0 >/dev/null 2>&1
  sysctl --system >/dev/null 2>&1 && echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Flushed sysctl rules${NC}" || echo -e "\n${RED}[${WHITE}-${RED}]${P} Error: No sysctl rules were flushed${NC}"

  sleep 1

  nft flush ruleset >/dev/null 2>&1 && echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Flushed nft firewall${NC}" || echo -e "\n${RED}[${WHITE}-${RED}] Error: No firewall was flushed${NC}"

  sleep 1

  if ! pgrep -x tor >/dev/null 2>&1 || ! pgrep -a i2pd >/dev/null 2>&1; then

    echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Tor/i2p not Runs${NC}"
    exit 0

  else

    echo -e "\n${RED}[${WHITE}X${RED}] Tor/i2p Runs, try again${NC}"
    exit 1

  fi

}

# <-- Function Calls (arguments) --> #

if [[ $# -gt 0 ]]; then

  while [ $# -gt 0 ]; do
    case $1 in
    --start)
      mode=1

      if [ $EUID -ne 0 ]; then
        echo -e "\n${RED}[${WHITE}-${RED}] Run as root${NC}"
        exit 1
      fi

      torrc

      if ! pgrep -x tor >/dev/null 2>&1 || ! pgrep -a i2pd >/dev/null 2>&1; then
        echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Launching Archnon ...${NC}"
        config
        exit 0
      else
        echo -e "\n${RED}[${YELLOW}warn${RED}]${P} Tor/i2pd Runs, stop first${NC}"
        exit 1
      fi

      shift
      break

      ;;

    --stop)
      mode=2

      if [ $EUID -ne 0 ]; then
        echo -e "\n${RED}[${WHITE}X${RED}] Run as root${NC}"
        exit 1
      fi

      stop

      shift
      break

      ;;

    --myip)

      mode=3

      myip

      shift
      break

      ;;

    --changeid)

      mode=4

      if pgrep -x tor >/dev/null 2>&1; then

        if echo -e "AUTHENTICATE \"\"\nSIGNAL NEWNYM\nQUIT" | nc $ADDR $CONTROL >/dev/null 2>&1; then
          echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Built new circuit${NC}"
        else
          echo -e "\n${RED}[${WHITE}-${RED}] Error: no IP changed${NC}"
        fi

      else

        echo -e "\n${RED}[${WHITE}-${RED}] Tor/i2p not Runs${NC}" # i miss you archnon
        exit 1

      fi

      shift
      break

      ;;

    --enable)

      mode=5

      if [ "$EUID" -ne 0 ]; then
        echo -e "\n${RED}[${WHITE}X${RED}] Run as root${NC}"
        exit 1
      fi

      ### Check for a valid torrc first ###
      torrc

      ### Create service files ###
      createsv

      ### Exceptions ###

      if ! (command -v systemctl >/dev/null 2>&1 || command -v runit >/dev/null 2>&1 || command -v rc-service >/dev/null 2>&1); then
        echo -e "\n${RED}[${WHITE}-${RED}] Error: this system doesnt supports service${NC}"
        echo -e "\n${RED}[${YELLOW}!${RED}] This script supports: ${ORANGE}systemd, runit, open-rc${NC}"
        exit 1
      fi

      ### For systemd ###

      if [ -f /etc/systemd/system/archnon.service ] && command -v systemctl >/dev/null 2>&1; then

        echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Service Manager: ${GREEN}systemd${NC}"

        if systemctl is-enabled archnon >/dev/null 2>&1; then
          echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Archnon is enabled${NC}"
          exit 1
        else
          systemctl enable archnon >/dev/null 2>&1 && echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Archnon enabled${NC}" || echo -e "\n${RED}[${WHITE}-${RED}] Error: unexcepted${NC}"
        fi

      fi

      ### For runit ###

      if [ -f /etc/sv/archnon/run ] && command -v runit >/dev/null 2>&1; then

        echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Service Manager: ${GREEN}runit${NC}"

        if [ -d /run/runit/service ]; then
          export RSDIR=/run/runit/service

        elif [ -d /etc/service ]; then
          export RSDIR=/etc/service

        elif [ -d /var/run/service ]; then
          export RSDIR=/var/run/servie

        fi

        if ls -l $RSDIR/archnon/ >/dev/null 2>&1; then

          echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Archnon is enabled${NC}"
          exit 0

        else

          ln -s /etc/sv/archnon $RSDIR >/dev/null 2>&1 && echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Archnon enabled${NC}" || echo -e "\n${RED}[${WHITE}-${RED}] Error: unexcepted${NC}"

        fi

      fi

      ### For open-rc ###

      if [ -f /etc/init.d/archnon ] && command -v rc-update >/dev/null 2>&1; then

        echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Service Manager: ${GREEN}open-rc${NC}"

        if rc-update | grep -IE "archnon" >/dev/null 2>&1; then
          echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Archnon is enabled${NC}"
          exit 0
        else
          rc-update add archnon default >/dev/null 2>&1 && echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Archnon enabled${NC}" || echo -e "\n${RED}[${WHITE}-${RED}] Error: unexcepted${NC}"
        fi

      fi

      shift
      break

      ;;

    --disable)

      # You cannot run this as an standard user #

      mode=6

      if [ "$EUID" -ne 0 ]; then
        echo -e "\n${RED}[${WHITE}-${RED}] Run as root${NC}"
        exit 1
      fi

      ### Check for a valid torrc first ###
      torrc

      ### Create service files ###
      createsv

      ### For systemd ###

      if [ -f /etc/systemd/system/archnon.service ] && command -v systemctl >/dev/null 2>&1; then

        echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Service Manager: ${GREEN}systemd${NC}"

        if ! systemctl is-enabled archnon >/dev/null 2>&1; then
          echo -e "\n${RED}[${WHITE}-${RED}] Archnon is disabled${NC}"
          exit 1
        else
          systemctl disable archnon >/dev/null 2>&1 && echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Archnon disabled${NC}" || echo -e "\n${RED}[${WHITE}-${RED}] Error: unexcepted${NC}"
        fi

      fi

      ### For runit ###

      if [ -f /etc/sv/archnon/run ] && command -v runit >/dev/null 2>&1; then

        if [ -d /run/runit/service ]; then
          RSDIR=/run/runit/service

        elif [ -d /etc/service ]; then
          RSDIR=/etc/service

        elif [ -d /var/run/service ]; then
          RSDIR=/var/run/service
        fi

        if ! ls -l $RSDIR/archnon/ >/dev/null 2>&1; then
          echo -e "\n${RED}[${WHITE}-${RED}] Archnon is disabled${NC}"
          exit 1
        else
          rm -rf $RSDIR/archnon >/dev/null 2>&1 && echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Archnon disabled${NC}" || echo -e "\n${RED}[${WHITE}-${RED}] Error: unexcepted${NC}"
        fi

      fi

      ### For open-rc ###

      if [ -f /etc/init.d/archnon ] && command -v rc-service >/dev/null 2>&1; then

        if ! rc-update | grep -IE "archnon" >/dev/null 2>&1; then
          echo -e "\n${RED}[${WHITE}-${RED}] Archnon is disabled${NC}"
          exit 1
        else
          rc-update del archnon default >/dev/null 2>&1 && echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Archnon disabled ${NC}" || echo -e "\n${RED}[${WHITE}-${RED}] Error: unexcepted${NC}"
        fi

      fi

      shift
      break

      ;;

    --restart)

      # You cannot run this as an standard user #

      mode=7

      if [ $EUID -ne 0 ]; then
        echo -e "\n${RED}[${WHITE}X${RED}] Run as root${NC}"
        exit 1
      fi

      torrc

      echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Launching Archnon ...${NC}"

      pkill -9 tor >/dev/null 2>&1
      pkill -9 i2pd >/dev/null 2>&1
      pkill -9 NetworkManager >/dev/null 2>&1

      config

      shift
      break

      ;;

    --status)
      mode=8

      sleep 1

      if pgrep -x tor >/dev/null 2>&1; then
        echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Tor: ${GREEN}active${NC}"
        echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Service Ports: "
        echo -e "\n${BLUE}[${LB}OK${BLUE}]${ORANGE} SocksPort: ${WHITE}$ADDR${GREEN}:${WHITE}$SOCKS${NC}"
        echo -e "\n${BLUE}[${LB}OK${BLUE}]${ORANGE} TransPort: ${WHITE}$ADDR${GREEN}:${WHITE}$TRANS${NC}"
        echo -e "\n${BLUE}[${LB}OK${BLUE}]${ORANGE} ControlPort: ${WHITE}$ADDR${GREEN}:${WHITE}$CONTROL${NC}"
        echo -e "\n${BLUE}[${LB}OK${BLUE}]${ORANGE} DNSPort: ${WHITE}$ADDR${GREEN}:${WHITE}$TDNS${NC}"
        echo -e "\n${BLUE}[${LB}OK${BLUE}]${ORANGE} HTTPTunnelPort: ${WHITE}$ADDR${GREEN}:${WHITE}$HTTP${NC}"

      else
        echo -e "\n${RED}[${WHITE}OK${RED}]${P} Tor: ${RED}not active${NC}"
      fi

      echo -ne "\n"
      sleep 1

      if pgrep -a i2pd >/dev/null 2>&1; then
        echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} i2pd: ${GREEN}active${NC}"
        echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Service Ports: ${NC}"
        echo -e "\n${BLUE}[${LB}OK${BLUE}]${ORANGE} Socks Proxy: ${WHITE}$ADDR${GREEN}:${WHITE}$I2PSOCKS${NC}"
        echo -e "\n${BLUE}[${LB}OK${BLUE}]${ORANGE} Http Proxy: ${WHITE}$ADDR${GREEN}:${WHITE}$I2PHTTP${NC}"
      else
        echo -e "\n${RED}[${WHITE}OK${RED}]${P} i2pd: ${RED}not active${NC}"
      fi

      shift
      break

      ;;

    --help)
      mode=9

      help_p

      shift
      break

      ;;

    --* | -* | *)
      mode=10

      echo -e "\n${RED}[${WHITE}-${RED}] Error: no option ${YELLOW}'$1'${RED} found, try ${ORANGE}'archnon --help'${NC}"

      exit 1

      shift
      break

      ;;

    esac
  done

else
  help_p
fi
