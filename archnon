# Check IP -->
myip() {

  # There are many ways to check IP, first we have the full API

  # Default API: 'ip-api.com?fields=query,asname,org,country,region,continent,proxy,mobile,status'
  # <- I recommend to get clear info ->

  #check_api='ifconfig.co/json'

  #! curl $check_api -w "\n" -s -m 5 --user-agent "$user_agent" && echo -e "\n${RED}[${WHITE}X${RED}]${WHITE} Timeout for IP${NC}"

  # OR the minimal, which only fetch the IP
  # Default API: ifconfig.co

  check_ip=ifconfig.co/ip

  if pgrep -x tor >/dev/null 2>&1; then

    if ! curl -m 5 ifconfig.co >/dev/null 2>&1; then
      echo -e "\n${RED}[${WHITE}-${RED}] Check Timeout${NC}"
      exit 1
    else
      echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Public IP:${GREEN} $(curl -s -w "\n" -m 5 --user-agent "$user_agent" --socks5-hostname $ADDR:$SOCKS $check_ip)${NC}"
    fi

  else
    if ! curl -m 5 ifconfig.co >/dev/null 2>&1; then
      echo -e "\n${RED}[${WHITE}-${RED}] Check Timeout${NC}"
      exit 1
    else
      echo -e "\n${RED}[${WHITE}OK${RED}] Public IP: ${GREEN}$(curl -s -w "\n" -m 5 --user-agent "$user_agent" $check_ip)${NC}"
    fi
  fi
}
