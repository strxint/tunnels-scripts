    if ! dnf -y install --allowerasing "${pkgs[@]}"; then
      echo -e "${RED}[${WHITE}-${RED}] Install Deps: ${ORANGE}${pkgs[@]}${NC}"
      exit 1
    fi
    wait

  elif [[ $(command -v yum) ]]; then

    pkgs=(nmap-ncat curl tor nftables procps-ng NetworkManager iproute coreutils util-linux bash e2fsprogs i2pd)

    if ! yum -y install "${pkgs[@]}"; then
      echo -e "${RED}[${WHITE}-${RED}] Install Deps: ${ORANGE}${pkgs[@]}${NC}"
      exit 1
    fi
    wait

  elif [[ $(command -v zypper) ]]; then

    pkgs=(nmap-ncat curl tor nftables procps-ng NetworkManager iproute coreutils util-linux bash e2fsprogs i2pd)

    if ! zypper install "${pkgs[@]}"; then
      echo -e "${RED}[${WHITE}-${RED}] Install Deps: ${ORANGE}${pkgs[@]}${NC}"
      exit 1
    fi
    wait

  elif [[ $(command -v apk) ]]; then

    pkgs=(netcat-openbsd curl tor nftables procps networkmanager iproute2 coreutils util-linux bash e2fsprogs i2pd)

    if ! apk add --no-cache "${pkgs[@]}"; then
      echo -e "${RED}[${WHITE}-${RED}] Install Deps: ${ORANGE}${pkgs[@]}${NC}"
      exit 1
    fi
    wait

  elif [[ $(command -v xbps-install) ]]; then

    pkgs=(openbsd-netcat curl tor iproute2 coreutils util-linux bash nftables procps-ng NetworkManager e2fsprogs i2pd)

    if ! xbps-install -Sy -f -y "*" "${pkgs[@]}"; then
      echo -e "${RED}[${WHITE}-${RED}] Install Deps: ${ORANGE}${pkgs[@]}${NC}"
      exit 1
    fi
    wait

  elif [[ $(command -v emerge) ]]; then

    pkgs=(netcat-openbsd tor curl nftables procps network-manager iproute2 coreutils util-linux bash e2fsprogs i2pd)

    if ! emerge -v --oneshot --keep-going ${pkgs[@]}; then
      echo -e "${RED}[${WHITE}-${RED}] Install Deps: ${ORANGE}${pkgs[@]}${NC}"
      exit 1
    fi
    wait
  else
    pkgs=(netcat-openbsd tor curl nftables procps network-manager iproute2 coreutils util-linux bash e2fsprogs i2pd)

    echo -e "${RED}[${WHITE}-${RED}] Install Deps: ${ORANGE}${pkgs[@]}${NC}"
    exit 1
  fi
fi

