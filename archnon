# Service Managers && Boot Automation

createsv() {

  ##### For systemd #####

  if [ ! -f /etc/systemd/system/archnon.service ] && command -v systemctl >/dev/null 2>&1; then
    touch /etc/systemd/system/archnon.service >/dev/null 2>&1
    cat <<EOT >/etc/systemd/system/archnon.service
[Unit]
Description=Archnon Anonymous

[Service]
Type=forking
ExecStart=/usr/local/bin/archnon --start
RemainAfterExit=yes
User=root

[Install]
WantedBy=multi-user.target
EOT

  fi

  ##### For runit ######

  if [ ! -f /etc/sv/archnon/run ] && command -v runit >/dev/null 2>&1; then
    mkdir -p /etc/sv/archnon/ >/dev/null 2>&1
    touch /etc/sv/archnon/run >/dev/null 2>&1
    cat <<EOT >/etc/sv/archnon/run
#!/bin/sh
exec archnon --start
EOT
    chmod +x /etc/sv/archnon/run >/dev/null 2>&1
  fi

  #### For open-rc #####

  if [ ! -f /etc/init.d/archnon ] && command -v rc-service >/dev/null 2>&1; then
    touch /etc/init.d/archnon >/dev/null 2>&1
    cat <<EOT >/etc/init.d/archnon
#!/sbin/openrc-run
name=archnon
command="archnon"
command_args="--start"
command_background=true
pidfile="/run/${RC_SVCNAME}.pid"
depend() {
   need net
}
EOT
    chmod +x /etc/init.d/archnon >/dev/null 2>&1
  fi

}

